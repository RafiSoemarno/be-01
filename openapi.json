{
  "openapi": "3.0.3",
  "info": {
    "title": "Task API",
    "version": "1.0.0",
    "description": "A demonstrative, test-driven CRUD API for tasks. Tasks live entirely in memory; only the seed file is persisted."
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Local development" }
  ],
  "tags": [
    { "name": "meta", "description": "Route index, health, and documentation" },
    { "name": "tasks", "description": "Task CRUD operations" }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["meta"],
        "summary": "List all available routes",
        "operationId": "getRouteIndex",
        "responses": {
          "200": {
            "description": "The route index",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RouteIndex" }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["meta"],
        "summary": "Health probe",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The literal string `ok`",
            "content": {
              "text/plain": { "schema": { "type": "string", "example": "ok" } }
            }
          }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": ["meta"],
        "summary": "Interactive Swagger UI",
        "operationId": "getDocs",
        "responses": {
          "200": { "description": "The Swagger UI HTML page", "content": { "text/html": {} } }
        }
      }
    },
    "/tasks": {
      "get": {
        "tags": ["tasks"],
        "summary": "List tasks",
        "operationId": "listTasks",
        "parameters": [
          {
            "name": "done",
            "in": "query",
            "required": false,
            "description": "Filter by completion state.",
            "schema": { "type": "string", "enum": ["true", "false"] }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Case-sensitive substring match on `title`.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching tasks",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "post": {
        "tags": ["tasks"],
        "summary": "Create a task",
        "operationId": "createTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/NewTask" } }
          }
        },
        "responses": {
          "201": {
            "description": "The created task. `done` always starts false.",
            "headers": {
              "Location": {
                "description": "URL of the created task",
                "schema": { "type": "string", "example": "/tasks/4" }
              }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Task" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Server-assigned positive integer id.",
          "schema": { "type": "integer", "minimum": 1 }
        }
      ],
      "get": {
        "tags": ["tasks"],
        "summary": "Fetch a single task",
        "operationId": "getTask",
        "responses": {
          "200": {
            "description": "The task",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Task" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["tasks"],
        "summary": "Update a task",
        "operationId": "updateTask",
        "requestBody": {
          "required": true,
          "description": "At least one of `title` or `done`. Additional fields are ignored.",
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/TaskUpdate" } }
          }
        },
        "responses": {
          "200": {
            "description": "The updated task",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Task" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" }
        }
      },
      "delete": {
        "tags": ["tasks"],
        "summary": "Delete a task",
        "operationId": "deleteTask",
        "responses": {
          "204": { "description": "Deleted, no content" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "required": ["id", "title", "done"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "readOnly": true },
          "title": { "type": "string", "minLength": 1 },
          "done": { "type": "boolean" }
        }
      },
      "NewTask": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "example": "Write the tests" }
        }
      },
      "TaskUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "done": { "type": "boolean" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "example": "bad_request" },
              "message": { "type": "string", "example": "Invalid id \"abc\": expected a positive integer" }
            }
          }
        }
      },
      "RouteIndex": {
        "type": "object",
        "required": ["name", "version", "routes"],
        "properties": {
          "name": { "type": "string", "example": "Task API" },
          "version": { "type": "string", "example": "1.0.0" },
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["method", "path", "description"],
              "properties": {
                "method": { "type": "string", "example": "GET" },
                "path": { "type": "string", "example": "/tasks" },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation failed",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "UnsupportedMediaType": {
        "description": "Body was not application/json",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      }
    }
  }
}
